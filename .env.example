# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA_bot_tokeni

# Ilovasiz ishlash: ism va guruh Telegram orqali olinadi.
STANDALONE=true

# Botning o'z MongoDB bazasi (Docker varianti ichki MongoDBni o'zi ishga tushiradi).
MONGO_URI=mongodb://127.0.0.1:27017/enzo_bot

# Faqat eski ilova rejimi (STANDALONE=false) uchun. Mustaqil botga kerak emas.
JWT_SECRET=

# Skrinshotdagi natijani o'qish uchun (ENZO-APP ham Gemini ishlatadi).
# Bo'sh bo'lsa faqat skrinshot AI xizmati o'chiq; odatiy testlar ishlaydi.
GEMINI_API_KEY=
GEMINI_SCREENSHOT_MODEL=gemini-3.1-flash-lite

# Adminlarning Telegram ID'lari, vergul bilan (ID ni @userinfobot dan bilish mumkin)
ADMIN_IDS=111111111,222222222

# API va grafik sahifasi porti
PORT=8080

# Grafik sahifasi (Telegram Mini App) — HTTPS manzil, oxirida /webapp/ bo'lsin. Bo'sh bo'lsa "📈 Grafik" tugmasi chiqmaydi
WEBAPP_URL=

# Botdagi grafik rasmi (QuickChart). O'chirish uchun bo'sh qoldiring: CHART_URL=
# CHART_URL=https://quickchart.io/chart

# Davomat ro'yxati admin uchun necha daqiqa oldin ochiladi (standart 30)
# ATTENDANCE_OPEN_BEFORE_MIN=30

# Tahlilning eng qisqa uzunligi, belgi (standart 15)
# MIN_ANALYSIS_CHARS=15

# Ilova frontend domenlari (vergul bilan). Masalan: https://app.example.uz,http://localhost:5173
# Faqat botning o'z Mini App sahifasi uchun bo'sh qolishi mumkin.
CORS_ORIGINS=

# Ixtiyoriy: server ishga tushganda Telegram getMe orqali avtomatik aniqlanadi.
# BOT_USERNAME=enzo_academy_bot
